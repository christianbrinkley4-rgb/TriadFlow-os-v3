# TriadFlow build-time configuration.
# All vars are inlined into the static export at `npm run build` — they
# are PUBLIC (visible in the JS bundle), so do not put secrets here.

# Make.com (or Zapier) catch-hook URL that receives the lead JSON payload.
# Defaults to the TriadFlow Make.com hook if not set.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=https://hook.us2.make.com/fvxqryg1s9oldjuaf8s4xkoxurmy0zhh

# Facebook Pixel ID. Leave blank to disable Pixel loading.
NEXT_PUBLIC_FB_PIXEL_ID=183351282

# GA4 Measurement ID. Leave blank to disable GA4 loading.
NEXT_PUBLIC_GA4_ID=G-DSLPLQ3TSQ

# If deploying under a sub-path (e.g. GitHub Pages project site), set this:
# NEXT_PUBLIC_BASE_PATH=/triadflow-os
